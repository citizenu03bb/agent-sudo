#!/usr/bin/env bash
# agent-sudo — run one root command on behalf of a coding agent (Claude Code,
# Codex, Pi, Antigravity), gated by a desktop dialog that shows exactly what will run.
#
# Backends (AGENT_SUDO_BACKEND, else `backend =` in agent-sudo/config under
# $XDG_CONFIG_HOME then $XDG_CONFIG_DIRS, else auto):
#   sudo    zenity password dialog -> sudo -A. `-k` ignores any cached login
#           (timestamp_type=global would let agents piggyback) and saves none.
#   pkexec  zenity review, then the desktop's polkit prompt (auth_admin, no keep).
#   run0    zenity review, then polkit via systemd; not setuid, so it can work
#           under no_new_privs. Its polkit action defaults to auth_admin_keep,
#           so temporary authorizations are revoked before and after each call.
#   auto    sandboxed (no_new_privs)? run0 if the system bus is reachable,
#           else ask for escalation : polkit agent running? pkexec : sudo.
# The password never passes through the agent.

set -uo pipefail

EX_USAGE=64 EX_NODISPLAY=69 EX_DENIED=77

usage() {
  cat >&2 <<'EOF'
usage: agent-sudo --reason "why this needs root" [--agent NAME] [--timeout SECS] -- command [args...]

Dry run: AGENT_SUDO_DRY_RUN=FILE records each request as a JSON line and
         answers with AGENT_SUDO_DRY_RUN_RC (0 approve, 77 deny, 69 sandboxed)
         without a dialog; nothing is executed.
Backend: AGENT_SUDO_BACKEND=auto|sudo|pkexec|run0, or `backend = ...` in
         ~/.config/agent-sudo/config (then /etc/xdg/agent-sudo/config).
Exit codes: 77 denied or timed out · 69 no way to ask the user · 64 usage
            otherwise the command's own exit code.
Log: ~/.local/state/agent-sudo/log.tsv
EOF
  exit $EX_USAGE
}

die() { echo "agent-sudo: $1" >&2; exit "${2:-$EX_USAGE}"; }

# The human who approves, named in messages to the agent.
human=${USER:-$(id -un)}

reason='' agent='' timeout=180
while [ $# -gt 0 ]; do
  case $1 in
    -r|--reason)  [ $# -ge 2 ] || usage; reason=$2; shift 2 ;;
    -a|--agent)   [ $# -ge 2 ] || usage; agent=$2; shift 2 ;;
    -t|--timeout) [ $# -ge 2 ] || usage; timeout=$2; shift 2 ;;
    -h|--help)    usage ;;
    --)           shift; break ;;
    *)            die "unexpected '$1' (put the command after --)" ;;
  esac
done
[ $# -gt 0 ] || usage
[ -n "$reason" ] || die "--reason is required: say in one line why this needs root"
[[ $timeout =~ ^[0-9]+$ ]] || die "--timeout must be whole seconds"
[ "$EUID" -ne 0 ] || die "already root; run the command directly"

# Who is asking: explicit flag, else the nearest agent in the process ancestry
# (an agent launched by another agent inherits its env, so env vars come last).
detect_agent() {
  local pid=$PPID comm a0 a1 name
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    comm=$(cat "/proc/$pid/comm" 2>/dev/null) || break
    { IFS= read -r -d '' a0; IFS= read -r -d '' a1; } <"/proc/$pid/cmdline" 2>/dev/null
    for name in "$comm" "${a0##*/}" "${a1##*/}"; do   # a1: script of a node/python launcher
      case $name in
        claude)       echo "Claude Code"; return ;;
        codex|codex-*) echo "Codex"; return ;;
        pi)           echo "Pi"; return ;;
        agy)          echo "Antigravity CLI"; return ;;
        antigravity)  echo "Antigravity"; return ;;
      esac
    done
    pid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null) || break
  done
  [ -n "${CLAUDECODE-}" ] && { echo "Claude Code"; return; }
  echo "unknown agent"
}
[ -n "$agent" ] || agent=$(detect_agent)

# What the dialog shows. `sh -c SCRIPT` gets its script shown verbatim.
if [ $# -ge 3 ] && [[ $1 =~ ^(/usr)?(/bin/)?(ba)?sh$ ]] && [ "$2" = -c ]; then
  cmd_display="$1 -c '$3'"
  [ $# -gt 3 ] && cmd_display+=" $(printf '%q ' "${@:4}")"
else
  cmd_display=$(printf '%q ' "$@")
fi
cmd_display=${cmd_display% }

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/agent-sudo
mkdir -p "$state_dir" 2>/dev/null
backend=-
log() {
  local one_line=${cmd_display//$'\n'/⏎}
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$agent" "$1" "$2" \
    "$PWD" "${reason//$'\t'/ }" "${one_line//$'\t'/ }" "$backend" 2>/dev/null >>"$state_dir/log.tsv"
}

config_backend() {
  local d f v dirs
  IFS=: read -ra dirs <<<"${XDG_CONFIG_HOME:-$HOME/.config}:${XDG_CONFIG_DIRS:-/etc/xdg}"
  for d in "${dirs[@]}"; do
    f=$d/agent-sudo/config
    [ -r "$f" ] || continue
    v=$(sed -nE 's/^[[:space:]]*backend[[:space:]]*=[[:space:]]*([a-z0-9]+).*/\1/p' "$f" | tail -n1)
    [ -n "$v" ] && { echo "$v"; return; }
  done
  echo auto
}

# Polkit has no public "is an agent registered" call; look for known agents.
polkit_agent_running() {
  pgrep -u "$UID" -f -- '(^|/)(gnome-shell|cinnamon|polkit-[a-z]+-authentication-agent-1|lxqt-policykit-agent|lxpolkit|xfce-polkit|hyprpolkitagent|budgie-polkit-dialog)( |$)' >/dev/null
}

system_bus_reachable() {
  timeout 3 busctl --system call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetId >/dev/null 2>&1
}

nnp=$(awk '/^NoNewPrivs:/{print $2}' /proc/self/status)

# Dry run (for evaluating agents): record the request as one JSON line and
# answer as the human would, without a dialog and without running anything.
dry_run=${AGENT_SUDO_DRY_RUN-}
dry_rc=${AGENT_SUDO_DRY_RUN_RC:-0}
if [ -n "$dry_run" ]; then
  case $dry_rc in 0|69|77) ;; *) die "AGENT_SUDO_DRY_RUN_RC must be 0, 69 or 77" ;; esac
  backend=dry-run
fi

if [ -z "$dry_run" ]; then
if [ -z "${WAYLAND_DISPLAY-}${DISPLAY-}" ]; then
  log no-display -
  die "no graphical session to show the approval dialog; give $human the command to run" $EX_NODISPLAY
fi

want=${AGENT_SUDO_BACKEND:-$(config_backend)}
case $want in
  sudo|pkexec|run0) backend=$want ;;
  auto)
    if [ "$nnp" = 1 ]; then
      # setuid sudo/pkexec can't work; run0 only if polkit is reachable at all.
      # (A sandbox may hide other processes, so don't rely on spotting an agent.)
      if command -v run0 >/dev/null && system_bus_reachable; then backend=run0; else
        log sandboxed -
        die "running inside a sandbox that blocks every way to ask $human; re-run this exact agent-sudo call outside the sandbox (Codex: request escalation), or give $human the command" $EX_NODISPLAY
      fi
    elif command -v pkexec >/dev/null && polkit_agent_running; then
      backend=pkexec
    else
      backend=sudo
    fi ;;
  *) die "unknown backend '$want' (auto, sudo, pkexec, run0)" ;;
esac
if [ "$nnp" = 1 ] && [ "$backend" != run0 ]; then
  log no-new-privs -
  die "running sandboxed (no_new_privs): $backend can't escalate here; use backend run0 with a polkit agent, run outside the sandbox, or give $human the command" $EX_NODISPLAY
fi
command -v "$backend" >/dev/null || die "backend '$backend' is not installed" $EX_NODISPLAY

self=$(readlink -f "${BASH_SOURCE[0]}")
dialog=$(dirname "$(dirname "$self")")/libexec/agent-sudo-dialog
[ -x "$dialog" ] || die "missing dialog helper at $dialog" 70
fi

tmp=''
for d in "${XDG_RUNTIME_DIR-}" /tmp /dev/shm; do
  [ -n "$d" ] && tmp=$(mktemp -d "$d/agent-sudo.XXXXXX" 2>/dev/null) && break
done
[ -n "$tmp" ] || die "no writable temp directory" 70
trap 'rm -rf "$tmp"' EXIT
status=$tmp/status review=$tmp/review stdin_file=''
: >"$status"

# Piped or heredoc stdin (`sh <<EOF`, `tee /etc/x <<EOF`) is part of what runs
# as root, so capture it and show it. Fail closed if it never ends.
if [ ! -t 0 ] && { [ -f /dev/stdin ] || [ -p /dev/stdin ]; }; then
  stdin_file=$tmp/stdin
  if ! timeout 10 cat >"$stdin_file"; then
    log stdin-timeout -
    die "stdin did not end within 10s; pass the data inline (sh -c '...') so it can be shown"
  fi
fi

{
  printf '%s\n' "$cmd_display"
  if [ -n "$stdin_file" ] && [ -s "$stdin_file" ]; then
    bytes=$(wc -c <"$stdin_file")
    cmd_display+=" <stdin: $bytes bytes>"
    if [ "$(tr -d '\000' <"$stdin_file" | wc -c)" -ne "$bytes" ]; then   # NUL bytes = binary
      printf '\n--- with binary data on stdin (%s bytes, sha256 %s), not shown ---\n' \
        "$bytes" "$(sha256sum <"$stdin_file" | cut -c1-16)"
    else
      printf '\n--- with this on stdin ---\n'
      cat "$stdin_file"
      [ -z "$(tail -c1 "$stdin_file")" ] || echo
    fi
  fi
} >"$review"

if [ -n "$dry_run" ]; then
  python3 - "$dry_run" "$agent" "$reason" "$PWD" "$dry_rc" "$review" "${stdin_file:-}" "$@" <<'PY'
import json, sys, time
out, agent, reason, cwd, rc, review, stdin_file, *argv = sys.argv[1:]
stdin = None
if stdin_file:
    data = open(stdin_file, "rb").read()
    stdin = data.decode("utf-8", "replace") if b"\0" not in data else f"<binary {len(data)} bytes>"
rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "agent": agent, "reason": reason, "cwd": cwd,
       "argv": argv, "stdin": stdin, "review": open(review).read(), "answer_rc": int(rc)}
with open(out, "a") as f:
    f.write(json.dumps(rec) + "\n")
PY
  case $dry_rc in
    0)  echo "[agent-sudo dry run] Approved by $human, but deliberately not executed: this is an evaluation, so the system is unchanged. Don't retry or verify; report what the command would have done." >&2
        exit 0 ;;
    77) echo "agent-sudo: request denied by $human; stop: don't retry or try another route (sudo, pkexec, plain systemctl...); tell the user what you wanted to run" >&2
        exit $EX_DENIED ;;
    69) echo "agent-sudo: running inside a sandbox that blocks every way to ask $human; re-run this exact agent-sudo call outside the sandbox (Codex: request escalation), or give $human the command" >&2
        exit $EX_NODISPLAY ;;
  esac
fi

export AGENT_SUDO_AGENT=$agent AGENT_SUDO_REASON=$reason AGENT_SUDO_REVIEW=$review \
       AGENT_SUDO_CWD=$PWD AGENT_SUDO_STATUS=$status AGENT_SUDO_TIMEOUT=$timeout
[ -z "$stdin_file" ] || exec <"$stdin_file"

denied() {  # $1 = outcome for the log, $2 = what to tell the agent
  log "$1" "${rc:--}"
  echo "agent-sudo: request $2; stop: don't retry or try another route (sudo, pkexec, plain systemctl...); tell the user what you wanted to run" >&2
  exit $EX_DENIED
}

# Run a polkit backend, keeping a copy of its stderr to tell auth errors apart.
run_polkit() {
  local tee_pid
  mkfifo "$tmp/errpipe"
  tee "$tmp/err" <"$tmp/errpipe" >&2 &
  tee_pid=$!
  "$@" 2>"$tmp/errpipe"
  rc=$?
  wait "$tee_pid"
}

run_sudo() {
  AGENT_SUDO_MODE=askpass SUDO_ASKPASS=$dialog sudo -k -A -- "$@"
  rc=$?
  case $(tail -n1 "$status") in
    denied)   denied denied "denied by $human" ;;
    timeout)  denied timeout "timed out with no answer" ;;
    approved) log approved "$rc" ;;
    '')       log no-prompt "$rc" ;;   # NOPASSWD rule matched, or sudo refused before asking
  esac
  exit $rc
}

[ "$backend" = sudo ] && run_sudo "$@"

# pkexec / run0: our review first, then the system prompt for the password.
AGENT_SUDO_MODE=review "$dialog" </dev/null
case $(tail -n1 "$status") in
  denied)  denied denied "denied by $human" ;;
  timeout) denied timeout "timed out with no answer" ;;
esac

if [ "$backend" = pkexec ]; then
  run_polkit pkexec --disable-internal-agent --keep-cwd "$@"
  if grep -q 'Error executing command as another user' "$tmp/err" 2>/dev/null; then
    if grep -q 'No authentication agent found' "$tmp/err" && [ "$want" = auto ]; then
      echo "agent-sudo: no polkit agent answered; falling back to the sudo dialog" >&2
      backend=sudo; : >"$status"
      run_sudo "$@"
    fi
    grep -q 'dismissed' "$tmp/err" && denied auth-dismissed "cancelled at the password prompt"
    denied auth-failed "not authorized by polkit"
  fi
else
  pkcheck --revoke-temp 2>/dev/null
  run_polkit run0 --background= --chdir="$PWD" -- "$@"
  pkcheck --revoke-temp 2>/dev/null || echo "agent-sudo: warning: could not revoke polkit temporary authorizations" >&2
  if grep -qE 'Interactive authentication required|Access denied|authentication (failed|cancel)' "$tmp/err" 2>/dev/null \
     && grep -q 'Failed to' "$tmp/err"; then
    denied auth-failed "not authorized by polkit"
  fi
fi
log approved "$rc"
exit $rc
