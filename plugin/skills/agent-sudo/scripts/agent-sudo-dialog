#!/usr/bin/env bash
# Dialogs for agent-sudo. Modes (AGENT_SUDO_MODE):
#   askpass   SUDO_ASKPASS for the sudo backend (default, confirm = auth): shown
#             only when sudo needs the password; this prompt is the review.
#   review    Approve / Deny before anything runs (confirm = always).
#   password  SUDO_ASKPASS after an approved review (confirm = always): shown
#             only if sudo still needs the password.
# The password goes from zenity straight to sudo on stdout; agent-sudo never
# sees it. Records each outcome in $AGENT_SUDO_STATUS. Long requests (big
# scripts, heredoc stdin) are shown in a scrollable review window.

set -u
[ -n "${AGENT_SUDO_STATUS-}" ] && [ -r "${AGENT_SUDO_REVIEW-}" ] \
  || { echo "agent-sudo-dialog: only agent-sudo may call this" >&2; exit 1; }

# Keep all caller-controlled text small enough for a non-scrolling label.
# Byte lengths are conservative for UTF-8; never truncate the actual request.
INLINE_MAX_LINES=8 INLINE_MAX_COLUMNS=48
mode=${AGENT_SUDO_MODE:-askpass}
timeout=${AGENT_SUDO_TIMEOUT:-180}

record() { echo "$1" >>"$AGENT_SUDO_STATUS"; }
# Passwords given to sudo so far: a second request means the last one was wrong.
tries_file=$(dirname "$AGENT_SUDO_STATUS")/tries
tries=$(cat "$tries_file" 2>/dev/null || echo 0)
given() { echo $((tries + 1)) >"$tries_file"; }
deny_from() { [ "$1" -eq 5 ] && record timeout || record denied; exit 1; }

lines=$(wc -l <"$AGENT_SUDO_REVIEW")
context="Why (agent's words, unverified):
        ${AGENT_SUDO_REASON}

Where:  ${AGENT_SUDO_CWD}"
inline=0
if {
  printf '%s wants to run as root:\n\n' "$AGENT_SUDO_AGENT"
  sed 's/^/    /' "$AGENT_SUDO_REVIEW"
  printf '\n%s\n' "$context"
} | LC_ALL=C awk \
    -v lines="$INLINE_MAX_LINES" -v columns="$INLINE_MAX_COLUMNS" \
    'length > columns { large=1 } END { exit (large || NR > lines) }'; then
  inline=1
fi
if [ $inline -eq 1 ]; then
  what="${AGENT_SUDO_AGENT} wants to run as root:

$(sed 's/^/    /' "$AGENT_SUDO_REVIEW")"
fi

# The long form: everything in one scrollable page.
review_window() {  # $1 = ok label
  local page
  page=$(dirname "$AGENT_SUDO_STATUS")/page
  {
    printf '%s wants to run this as root.\n\n%s\n\n' "$AGENT_SUDO_AGENT" "$context"
    printf '%.0s─' {1..72}; echo
    cat "$AGENT_SUDO_REVIEW"
  } >"$page"
  zenity --text-info --filename="$page" --font="monospace 10" \
    --title="agent-sudo: review root request (${lines} lines)" --width=680 --height=480 \
    --ok-label="$1" --cancel-label=Deny --timeout="$timeout" 2>/dev/null
}

if [ "$mode" = review ]; then
  if [ $inline -eq 1 ]; then
    zenity --question --no-markup --title="agent-sudo: root request" --width=680 \
      --text="${what}

${context}


${AGENT_SUDO_HINT:-Approve to run it. The system may ask for your password next.}" \
      --ok-label=Approve --cancel-label=Deny --timeout="$timeout" 2>/dev/null
  else
    review_window "Approve"
  fi
  rc=$?
  [ $rc -eq 0 ] && { record approved; exit 0; }
  deny_from $rc
fi

retry=''
[ "$tries" -gt 0 ] && retry=$'WRONG PASSWORD, try again.\n\n'

if [ "$mode" = password ]; then
  # Already reviewed and approved: just say what the password is for.
  title="agent-sudo: password"
  text="${retry}You approved the request in the review window.

sudo needs your password to run it, and then remembers your login for a
few minutes."
  ok=Run
else
  # askpass: the password prompt is the review.
  if [ $inline -eq 0 ] && [ "$tries" -eq 0 ]; then
    review_window "Continue to approval" || deny_from $?
  fi
  # Never put oversized metadata back into the password dialog after review.
  if [ $inline -eq 0 ]; then
    what="The full request was shown in the review window."
    context=''
  fi
  title="agent-sudo: root request"
  text="${retry}${what}

${context}


Type your password to run it. sudo then remembers your login for a few
minutes, so requests in that window run without asking."
  ok=Approve
fi

pw=$(zenity --entry --hide-text --title="$title" --width=680 --text="$text" \
  --ok-label="$ok" --cancel-label=Deny --timeout="$timeout" 2>/dev/null)
rc=$?

if [ $rc -eq 0 ] && [ -n "$pw" ]; then
  record approved
  given
  printf '%s\n' "$pw"
  exit 0
fi
deny_from $rc
