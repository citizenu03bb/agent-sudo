#!/usr/bin/env bash
# Stand-in for pkexec in tests: runs the command as the caller, never escalates.
[ -z "${FAKE_POLKIT_CALLS-}" ] || echo pkexec >>"$FAKE_POLKIT_CALLS"
case ${FAKE_PKEXEC_ERROR-} in
  missing) echo 'Error executing command as another user: No authentication agent found.' >&2; exit 127 ;;
  denied) echo 'Error executing command as another user: Request dismissed' >&2; exit 126 ;;
esac
while [ $# -gt 0 ]; do case $1 in --*) shift ;; *) break ;; esac; done
exec "$@"
