#!/usr/bin/env bash
# Stand-in for sudo in tests: never escalates, runs the command as the caller.
#   FAKE_SUDO_CACHED=1    the user's sudo login is fresh (or a NOPASSWD rule
#                         matches): run without asking for a password
#   FAKE_SUDO_PASSWORD    the right password (default: secret)
#   FAKE_SUDO_CALLS       file that records each invocation's arguments
[ -n "${FAKE_SUDO_CALLS-}" ] && printf '%s\n' "$*" >>"$FAKE_SUDO_CALLS"
while [ $# -gt 0 ]; do
  case $1 in
    -A|-k|-n|-l) ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done
[ "${FAKE_SUDO_CACHED:-0}" = 1 ] && exec "$@"
for _ in 1 2 3; do
  pw=$("$SUDO_ASKPASS" "[sudo] password: ") || { echo "sudo: no password was provided" >&2; exit 1; }
  [ "$pw" = "${FAKE_SUDO_PASSWORD:-secret}" ] && exec "$@"
  echo "Sorry, try again." >&2
done
echo "sudo: 3 incorrect password attempts" >&2
exit 1
