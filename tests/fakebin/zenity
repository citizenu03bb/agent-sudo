#!/usr/bin/env bash
# Stand-in for zenity in tests. Records what would be shown in $FAKE_ZENITY_OUT.
# FAKE_ZENITY_ANSWER: deny (default) answers Deny to password and review dialogs;
# approve answers Approve, typing $FAKE_ZENITY_PASSWORD (default: secret);
# crash kills the dialog helper before it can record anything. In the default
# deny mode the only "continue" is the long-request review window in the
# password modes, which is followed by the (denied) password dialog.

{
  for a in "$@"; do
    case $a in
      --entry|--question|--text-info) echo "=== $a" ;;
      --title=*) echo "[title] ${a#--title=}" ;;
      --text=*) echo "${a#--text=}" ;;
      --filename=*) cat "${a#--filename=}" ;;
    esac
  done
} >>"${FAKE_ZENITY_OUT:-/dev/null}"

case ${FAKE_ZENITY_ANSWER:-deny} in
  approve)
    case " $* " in *" --entry "*) printf '%s\n' "${FAKE_ZENITY_PASSWORD:-secret}" ;; esac
    exit 0 ;;
  crash) kill -9 "$PPID"; exit 1 ;;
esac
case ${AGENT_SUDO_MODE-} in askpass|collect|feed)
  case " $* " in *" --text-info "*) exit 0 ;; esac
esac
exit 1
